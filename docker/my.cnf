[mysqld]
# no tcp at all, the app talks over the unix socket
#nothing outside the container can reach the database, not even if it asks nicely
skip-networking = 1
socket = /run/mysqld/mysqld.sock
pid-file = /run/mysqld/mysqld.pid
datadir = /data/mysql
tmpdir = /tmp

user = mysql
bind-address = 127.0.0.1

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# packuments for big packages are still chunky even after gzipping into a blob
max_allowed_packet = 128M

# Small box defaults. This is not a busy oltp database, it's a registry with a hobby
innodb_buffer_pool_size = 128M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
max_connections = 60
table_open_cache = 400
performance_schema = OFF

# keep the slow query log off unless somebody is actually debugging
slow_query_log = 0

[client]
socket = /run/mysqld/mysqld.sock
default-character-set = utf8mb4

[mysql]
socket = /run/mysqld/mysqld.sock
